{
  "version": 2,
  "framework": null,
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    },
    "api/cron.php": {
      "runtime": "vercel-php@0.7.3",
      "maxDuration": 60
    }
  },
  "routes": [
    {
      "src": "/api/cron(.*)",
      "dest": "/api/cron.php"
    },
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
      "src": "/vendor/(.*)",
      "dest": "/public/vendor/$1"
    },
    {
      "src": "/mixpost/(.*)",
      "dest": "/public/mixpost/$1"
    },
    {
      "src": "/(favicon\\.ico|robots\\.txt|css/.*|js/.*|images/.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php",
    "VIEW_COMPILED_PATH": "/tmp/views",
    "CACHE_STORE": "database",
    "SESSION_DRIVER": "database",
    "QUEUE_CONNECTION": "database",
    "LOG_CHANNEL": "stderr"
  }
}
