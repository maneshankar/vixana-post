# ==============================================================================
# MIXPOST SERVERLESS (VERCEL + SUPABASE) CONFIGURATION
# ==============================================================================

APP_NAME="Mixpost"
APP_ENV=production
APP_KEY=base64:YOUR_GENERATED_APP_KEY_HERE
APP_DEBUG=false
APP_URL=https://your-mixpost-app.vercel.app

LOG_CHANNEL=stderr
LOG_LEVEL=info

# ==============================================================================
# SUPABASE POSTGRESQL DATABASE CONFIGURATION
# Get these from Supabase Dashboard -> Project Settings -> Database (Connection String / URI)
# ==============================================================================
DB_CONNECTION=pgsql
DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres
DB_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
DB_SSLMODE=require

# ==============================================================================
# CACHE, SESSIONS & QUEUES (Stored in PostgreSQL Database)
# ==============================================================================
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

# ==============================================================================
# SUPABASE S3-COMPATIBLE MEDIA STORAGE
# Get these from Supabase Dashboard -> Storage -> S3 Access Keys
# ==============================================================================
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=YOUR_SUPABASE_S3_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_SUPABASE_S3_SECRET_KEY
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=mixpost-media
AWS_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxx.supabase.co/storage/v1/s3
AWS_USE_PATH_STYLE_ENDPOINT=true

# ==============================================================================
# CRON & SCHEDULER SECURITY TOKEN
# Used by cron-job.org or GitHub Actions to ping https://your-mixpost-app.vercel.app/api/cron?token=YOUR_CRON_SECRET
# ==============================================================================
CRON_SECRET=generate_a_random_32_character_secret_here

# ==============================================================================
# AI CONTENT GENERATION & AUTO-POSTING (Multi-Provider)
# ==============================================================================
AI_PROVIDER=gemini # Options: gemini, openai, claude
GEMINI_API_KEY=YOUR_GOOGLE_GEMINI_API_KEY
GEMINI_MODEL=gemini-1.5-flash

OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY
CLAUDE_MODEL=claude-3-5-haiku-latest

AI_IMAGE_PROVIDER=pollinations # Options: pollinations (free, high quality), unsplash
UNSPLASH_ACCESS_KEY=

AI_POSTING_TOPICS="Artificial Intelligence news, SaaS growth strategies, web development tips, and tech productivity hacks"
AI_POSTING_TONE="engaging, informative, and actionable with crisp takeaways and hashtags"
AI_POST_INTERVAL_HOURS=12 # Automatically generate & queue a new post every 12 hours (0 to disable)

# ==============================================================================
# SOCIAL MEDIA PLATFORM DEVELOPER CREDENTIALS
# ==============================================================================

# X (Twitter) Developer API (OAuth 2.0)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# LinkedIn Developer App
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Facebook & Instagram (Meta Developer App)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Pinterest Developer App
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# YouTube (Google Cloud Console OAuth 2.0)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Threads (Meta Developer App)
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
